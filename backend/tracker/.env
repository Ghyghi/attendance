# === Django core ===
DJANGO_SETTINGS_MODULE=tracker.settings.dev   # or .prod
DJANGO_SECRET_KEY=django-insecure-REPLACE-WITH-A-REAL-RANDOM-SECRET-KEY
ALLOWED_HOSTS=localhost,127.0.0.1

# === Database (PostgreSQL) ===
DB_NAME=attendance_db
